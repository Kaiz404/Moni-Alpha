{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "bin/**"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ]
    },
    "test": {
      "env": [
        "TZ"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "GOCACHE",
    "GOPATH",
    "GOMODCACHE",
    "GOROOT",
    "LOCALAPPDATA",
    "USERPROFILE",
    "HOME"
  ]
}
