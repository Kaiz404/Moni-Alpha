# Moni AI backend configuration

# Supabase project URL — used to fetch the JWKS for JWT verification.
SUPABASE_URL=https://your-project.supabase.co

# OpenRouter API key (openrouter.ai/keys). Pay-as-you-go credit.
OPENROUTER_API_KEY=sk-or-your_key_here

# Only for Groq models in `pnpm bench:llm` (console.groq.com/keys).
# GROQ_API_KEY=

# Optional overrides
# PORT=8080
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GIN_MODE=debug
