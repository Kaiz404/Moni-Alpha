# Moni AI backend configuration

# Supabase project URL — used to fetch the JWKS for JWT verification.
SUPABASE_URL=https://your-project.supabase.co

# OpenRouter API key (openrouter.ai/keys). Pay-as-you-go credit.
OPENROUTER_API_KEY=sk-or-your_key_here

# Optional: Google Places API (New) server key, restricted by API to Places API (New) only.
# Without it the /v1/places endpoints answer {"status":"unavailable"}. See docs/SETUP.md.
# GOOGLE_PLACES_API_KEY=
# Calls per Pacific day, counted separately for autocomplete and details (default 1000).
# PLACES_DAILY_CAP=1000
# Calls per Pacific day for one user, per endpoint, within PLACES_DAILY_CAP (default 100).
# PLACES_USER_DAILY_CAP=100

# Only for Groq models in `pnpm bench:llm` (console.groq.com/keys).
# GROQ_API_KEY=

# Optional overrides
# PORT=8080
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GIN_MODE=debug
