# Supabase (publishable key, safe for the browser; RLS enforces ownership)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# What the sign-in QR opens on the phone: moni (daily app) or moni-e2e (Moni E2E)
NEXT_PUBLIC_MONI_APP_SCHEME=moni
# The Go AI gateway for @repo/ai (unset: no AI on the web). Its CORS_ALLOWED_ORIGINS must list this app's origin.
NEXT_PUBLIC_AI_API_URL=
# While set (an ISO time, e.g. 2026-10-14T07:30:00Z), every page but the legal documents shows the
# maintenance page, saying when Moni is back in the visitor's own time.
MONI_MAINTENANCE_UNTIL=
# Browser key for the Maps JavaScript API and the Maps Static API, restricted by HTTP referrer to this
# app's origins (docs/SETUP.md, Google Maps). Unset, Where you spend and Home's tile read Map unavailable.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
