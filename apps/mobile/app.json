{
  "expo": {
    "name": "Moni",
    "slug": "moni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moni",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.moni",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to use the camera to scan receipts."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.moni",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": { "light": "#17181A" },
              "colorControlActivated": { "light": "#17181A" },
              "colorControlHighlight": { "light": "#DDD5C5" },
              "windowBackground": { "light": "#FFFDF8" },
              "textColor": { "light": "#17181A" },
              "textColorPrimary": { "light": "#17181A" },
              "textColorPrimaryInverse": { "light": "#FFFDF8" },
              "textColorSecondary": { "light": "#6B665C" },
              "textColorSecondaryInverse": { "light": "#6B665C" }
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-router",
      "react-native-maps",
      "./plugins/with-notification-listener-manifest",
      [
        "expo-notifications",
        {
          "color": "#17181A"
        }
      ],
      "expo-speech-recognition",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your location for transaction tracking."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F2E9",
          "dark": {
            "backgroundColor": "#0B0A09"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d87a003d-1cc2-4aea-9fc3-497325c5703b"
      }
    },
    "owner": "kaiz404"
  }
}
