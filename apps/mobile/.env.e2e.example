# Env for the Moni E2E build (scripts/device/build-apk.sh) and the e2e seed (scripts/e2e/seed.mjs).
# Copy to .env.e2e, which git ignores. Keep the real values in the main checkout's copy, so every
# worktree finds them: both scripts read this worktree's .env.e2e, then the main checkout's, then
# .env, and the first value they read for a key wins.

# The dev Supabase project (yucjcjquwpwkgowzthhn) holds the e2e data. It has no real users.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only. seed.mjs uses it to create the e2e user and reset that user's rows.
# The build never inlines it, because only EXPO_PUBLIC_ variables reach the app.
# Get it with: npx supabase projects api-keys --project-ref <project-ref> --reveal
SUPABASE_SECRET_KEY=sb_secret_...

# The one e2e user. The address must start with e2e, or seed.mjs refuses to run.
# Maestro signs in with these through the sign-in page's email path.
E2E_EMAIL=e2e+moni@example.com
E2E_PASSWORD=<random password>

# Empty keeps the e2e build on the mock AI client, so it never calls the production backend.
EXPO_PUBLIC_AI_API_URL=
