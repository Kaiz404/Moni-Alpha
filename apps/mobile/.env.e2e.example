# Env for the Moni E2E build (scripts/device/build-apk.sh). Copy to .env.e2e, which git ignores.
# build-apk.sh reads .env.e2e first, then .env, and the first value it reads for a key wins.
# A key that is missing or commented out here falls back to .env.

# The moni-e2e Supabase project (operator action O4). Until it exists, leave these
# commented out and the e2e build uses the project in .env.
# EXPO_PUBLIC_SUPABASE_URL=https://<e2e-project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# Empty keeps the e2e build on the mock AI client, so it never calls the production backend.
EXPO_PUBLIC_AI_API_URL=
